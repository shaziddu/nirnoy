{
  "name": "DUDS NIRNOY",
  "description": "Tabulation system of the Dhaka University Debating Society (DUDS), built on Tabbycat",
  "repository": "https://github.com/__ORG__/nirnoy",
  "keywords": [
    "debate",
    "debating",
    "tabulation",
    "duds",
    "bangladesh"
  ],
  "website": "https://github.com/__ORG__/nirnoy",
  "logo": "https://raw.githubusercontent.com/__ORG__/nirnoy/main/tabbycat/static/logo-48x48.png",
  "addons": [
    "rediscloud:30",
    "heroku-postgresql:essential-0",
    "heroku-redis:mini"
  ],
  "env": {
    "DJANGO_SECRET_KEY": {
      "description": "A secret key for cryptographic signing of user sessions.",
      "generator": "secret"
    },
    "TAB_DIRECTOR_EMAIL": {
      "description": "Your email address. Tabbycat's developers may need to contact you to help diagnose any unexpected errors.",
      "value": ""
    },
    "TIME_ZONE": {
      "description": "Time zone of the tournament (IANA name). Keep Asia/Dhaka for tournaments in Bangladesh.",
      "value": "Asia/Dhaka"
    },
    "DISABLE_COLLECTSTATIC": {
      "description": "Leave this as-is.",
      "value": "1"
    },
    "ON_HEROKU": {
      "description": "Leave this as-is.",
      "value": "1"
    },
    "USING_NGINX": {
      "description": "Leave this as-is.",
      "value": "1"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    },
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nginx.git"
    },
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "heroku/python"
    }
  ],
  "stack": "heroku-22",
  "success_url": "/start/"
}
